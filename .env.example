# Supabase > Project Settings > API (or "API Keys").
# The publishable key (sb_publishable_...) or the legacy "anon" key both work.
# Both values are safe to expose in the browser; Row Level Security protects the data.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
