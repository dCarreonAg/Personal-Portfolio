---
import SiteLayout from '../layouts/SiteLayout.astro';

Astro.response.status = 404;
// The 404 page must not depend on Supabase being reachable.
const owner = 'Diego Carreón';
---

<SiteLayout title={`Not found · ${owner}`} description="This page does not exist." ownerName={owner}>
  <main class="notfound">
    <h1>Not found</h1>
    <p>This page doesn't exist, or the project isn't published.</p>
    <a href="/#work">← All work</a>
  </main>
</SiteLayout>

<style>
  .notfound { padding: clamp(48px, 8vw, 112px) 0 96px; }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(72px, 14vw, 200px);
    line-height: .82;
    text-transform: uppercase;
  }
  p {
    margin: 28px 0 24px;
    font-size: clamp(18px, 2vw, 22px);
    color: var(--text-2);
  }
  a { font-weight: 500; }
</style>
